// 1. Configuration du générateur (corrigé sans espaces)
generator client {
  provider = "prisma-client-js"
}

// 2. Connexion à la base de données
datasource db {
  provider = "postgresql"
}

// 3. Modèle Utilisateur (Architecte, Gardien, etc.)
model User {
  id            Int            @id @default(autoincrement())
  nom           String
  prenom        String
  email         String         @unique
  password      String
  role          Role           @default(AGENT)
  consultations Consultation[]
  createdAt     DateTime       @default(now())
}

// 4. Modèle Patient (Le cœur de votre TP actuel)
model Patient {
  id            Int            @id @default(autoincrement())
  nom           String
  prenom        String
  dateNaissance DateTime
  sexe          String
  telephone     String?
  adresse       String?
  region        String
  consultations Consultation[]
  createdAt     DateTime       @default(now())
}

// 5. Modèle Consultation (Corrigé pour éviter l'erreur P1012)
model Consultation {
  id           Int      @id @default(autoincrement())
  date         DateTime @default(now())
  symptomes    Json
  diagnosticIa String?
  confiance    Float?
  statut       String   @default("en_attente")
  notes        String?

  // Relations corrigées sur une seule ligne
  patient      Patient  @relation(fields: [patientId], references: [id])
  patientId    Int

  user         User     @relation(fields: [userId], references: [id])
  userId       Int
}

// 6. Énumération des rôles
enum Role {
  AGENT
  MEDECIN
  ADMIN
}
